# ─────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs
# Ne jamais committer .env dans git !
# ─────────────────────────────────────────

# ── MariaDB ──────────────────────────────
DB_ROOT_PASSWORD=changeme_root_password
DB_NAME=laundrymap
DB_USER=laundrymap
DB_PASSWORD=changeme_db_password

# ── Symfony ──────────────────────────────
# Générer avec : openssl rand -hex 32
APP_SECRET=changeme_32chars_random_hex

# ── Email Brevo (SMTP) ───────────────────
# Récupérer dans https://app.brevo.com > SMTP & API > SMTP
BREVO_CONNEXION=votre_login@smtp-brevo.com
BREVO_KEY_SMTP=votre_cle_smtp_brevo
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_FROM=noreply@votre-domaine.fr

# ── OAuth Google ─────────────────────────
# Créer les credentials sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme_google_secret

# ── API INSEE (validation SIREN) ─────────
# Générer un token sur https://api.insee.fr
INSEE_TOKEN=changeme_insee_token

# ── API WI-LINE ──────────────────────────
WILINE_SERVER=https://api.wi-line.fr
WILINE_USER=votre_email@wiline.fr
WILINE_CODE=votre_code_client_wiline
