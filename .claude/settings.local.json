{
  "permissions": {
    "allow": [
      "Bash(git config:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite build)",
      "Bash(npm install:*)",

      "Read(*)",
      "Write(*)"
    ],
    "deny": [
      "Read(.env)",
      "Write(.env)",

      "Read(.env.*)",
      "Write(.env.*)",

      "Read(/config/secrets/*)",
      "Write(/config/secrets/*)",

      "Read(/var/*)",
      "Write(/var/*)",

      "Read(/vendor/*)",
      "Write(/vendor/*)",

      "Read(/node_modules/*)",
      "Write(/node_modules/*)"
    ]
  }
}